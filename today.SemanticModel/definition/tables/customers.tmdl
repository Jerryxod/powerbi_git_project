		sourceColumn: CustomerName

		annotation SummarizationSetBy = Automatic

	column Gender
		dataType: string
		lineageTag: 36e81461-8f81-48bb-bb28-1c8af62f4446
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = Automatic

	column Age
		dataType: int64
		formatString: 0
		lineageTag: df1096fa-53b8-42fa-88b0-a090f0fdaac8
		summarizeBy: sum
		sourceColumn: Age

		annotation SummarizationSetBy = Automatic

	column City
		dataType: string
		lineageTag: 7807aaab-2ffe-4cb1-bf92-50319c839b61
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = Automatic

	column State
		dataType: string
		lineageTag: b73963ee-82cf-4c76-8365-ebb62d3f8d37
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	column Country
		dataType: string
		lineageTag: 16ab72fb-074a-45c0-9d99-5bd60e7bf8ea
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = Automatic

	column JoinDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 6e8e8d8f-5cdc-491c-9982-54f3a18c7d54
		summarizeBy: none
		sourceColumn: JoinDate

		variation Variation
			isDefault
			relationship: a8be9c26-3658-4501-a310-682d6f4e27e9
			defaultHierarchy: LocalDateTable_63493958-9db4-4fc5-a34b-37f0008dc215.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column CustomerSegment
		dataType: string
		lineageTag: a774df53-a7aa-4587-ac6e-beab63df6679
		summarizeBy: none
		sourceColumn: CustomerSegment

		annotation SummarizationSetBy = Automatic

	column 'Age Group'
		dataType: string
		lineageTag: 53a3a842-d7ac-4cd0-8184-63eff81c0e2b
		summarizeBy: none
		sourceColumn: Age Group

		annotation SummarizationSetBy = Automatic

	column 'first purchase date' = CALCULATE(MIN(sales[OrderDate]),FILTER(sales,sales[CustomerID]=customers[CustomerID]))
		formatString: General Date
		lineageTag: 27b1e029-3f66-4e30-9a3d-214d386fc94b
		summarizeBy: none

		variation Variation
			isDefault
			relationship: aead370f-e75e-429f-a0c3-bf72cf1b58ac
			defaultHierarchy: LocalDateTable_72f4e5b3-e5ab-4135-ae0f-80a2ff11b6b7.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'customer type' = IF(CALCULATE(COUNT(sales[OrderDate]))>1,"Repeat Customer", "One-time Customer")
		lineageTag: 9e42933b-93e3-4104-b310-bd6507b976e8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Cipher\Documents\portfolio_project\New folder\customers.csv"),[Delimiter=",", Columns=9, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"CustomerID", type text}, {"CustomerName", type text}, {"Gender", type text}, {"Age", Int64.Type}, {"City", type text}, {"State", type text}, {"Country", type text}, {"JoinDate", type date}, {"CustomerSegment", type text}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "Age Group", each if [Age] > 60 then "+ 60" else if [Age] >= 46 then "46 - 60" else if [Age] >= 36 then "36 - 45" else if [Age] >= 26 then "26 - 35" else "18 - 25"),
				    #"Reordered Columns" = Table.ReorderColumns(#"Added Conditional Column",{"CustomerID", "CustomerName", "Gender", "Age", "Age Group", "City", "State", "Country", "JoinDate", "CustomerSegment"})
				in
				    #"Reordered Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

