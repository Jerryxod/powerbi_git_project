	partition inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Cipher\Documents\portfolio_project\New folder\inventory.csv"),[Delimiter=",", Columns=5, Encoding=1252, QuoteStyle=QuoteStyle.None]),
